# Database (local dev: `docker compose up -d` starts a matching Postgres container).
# Copy this file to BOTH .env (read by the Prisma CLI) and .env.local (read by Next.js).
# In production (e.g. Neon): DATABASE_URL is the pooled connection string the
# app uses at runtime; DIRECT_URL is the unpooled one, used only for migrations.
# Locally there's no pooler, so both point at the same Docker Postgres.
DATABASE_URL="postgresql://cleaning:cleaning@localhost:5433/cleaning_management"
DIRECT_URL="postgresql://cleaning:cleaning@localhost:5433/cleaning_management"

# NextAuth (admin authentication only — employees use a personal link, no login yet)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # generate with: openssl rand -base64 32

# Protects /api/cron/generate-assignments — Vercel sends this as a Bearer
# token automatically for scheduled cron requests (see vercel.json). Not
# needed for local dev unless you're testing the cron route directly.
CRON_SECRET="" # generate with: openssl rand -base64 32
