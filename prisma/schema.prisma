// Cleaning Workforce Management — domain schema (Milestone 0)
// See PROJECT_SPEC.md and the approved plan for the rationale behind each decision.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: pooled connection (e.g. Neon's PgBouncer endpoint) — what
  // the app uses at runtime, safe under Vercel's serverless concurrency.
  // DIRECT_URL: unpooled connection, used only for migrate/db push — some
  // migration operations (advisory locks, prepared statements) don't work
  // through a pooler. Optional: if unset, Prisma falls back to DATABASE_URL
  // for both, which is exactly right for the local Docker Postgres (no
  // pooler involved) used in dev/test.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Company & auth identity
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Europe/Rome")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  employees         Employee[]
  customers         Customer[]
  activityTemplates ActivityTemplate[]

  @@map("companies")
}

// A reusable catalog entry ("Pulizia scale", "Mastelli"...) offered as a
// quick pick when setting up a new customer, so the admin doesn't retype
// the same common service name and duration for every new location. Picking
// one just copies its name/duration onto a new Service at creation time —
// there's no ongoing link, so editing or removing a template later never
// touches services already created from it.
model ActivityTemplate {
  id                       String   @id @default(cuid())
  companyId                String
  name                     String
  estimatedDurationMinutes Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("activity_templates")
}

enum Role {
  ADMIN
  EMPLOYEE
}

// Authentication identity. Only ADMIN users are created in Milestone 1;
// EMPLOYEE users will be created once real employee login is introduced
// (employees currently use a personal access-token link, see Employee.accessToken).
model User {
  id                 String   @id @default(cuid())
  companyId          String
  email              String   @unique
  password           String
  role               Role
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  employee Employee?

  @@index([companyId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Employees
// ---------------------------------------------------------------------------

model Employee {
  id          String   @id @default(cuid())
  companyId   String
  userId      String?  @unique // set only once real employee login is introduced
  firstName   String
  lastName    String
  phone       String?
  email       String?
  notes       String?
  active      Boolean  @default(true)
  // Opaque, unguessable token backing the personal dashboard link (/app/[token]).
  // Generated with crypto.randomBytes, never a sequential/guessable id.
  accessToken String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  assignments     Assignment[]
  absenceRequests AbsenceRequest[]

  @@index([companyId, active])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Customers, locations, services
// ---------------------------------------------------------------------------

// Represents both the contractual customer and the single physical
// address/site being cleaned — merged from what used to be two separate
// models (Customer + Location) since in practice a "location" was almost
// always a 1:1 stand-in for the customer relationship. A business with
// multiple sites (e.g. a condominium with several stairwells) is
// represented as multiple Customer records, one per site.
model Customer {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  addressLine String
  city        String
  postalCode  String
  province    String
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  services Service[]

  @@index([companyId, active])
  @@map("customers")
}

model Service {
  id                       String   @id @default(cuid())
  companyId                String
  customerId               String
  name                     String
  description              String?
  estimatedDurationMinutes Int
  operationalNotes         String?
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  customer           Customer            @relation(fields: [customerId], references: [id])
  recurringSchedules RecurringSchedule[]
  assignments        Assignment[]

  @@index([companyId, active])
  @@index([customerId])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Recurring schedules (templates) & dated assignments
// ---------------------------------------------------------------------------

// Template for a weekly recurring cleaning activity. Actual dated Assignments
// are generated from active schedules by lib/scheduling — see the generation
// strategy documented in the approved plan.
model RecurringSchedule {
  id                       String    @id @default(cuid())
  companyId                String
  serviceId                String
  dayOfWeek                Int // 0 = Sunday .. 6 = Saturday
  estimatedDurationMinutes Int
  effectiveFrom            DateTime  @db.Date
  effectiveUntil           DateTime? @db.Date
  active                   Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  service     Service      @relation(fields: [serviceId], references: [id])
  assignments Assignment[]

  @@index([companyId, active])
  @@map("recurring_schedules")
}

enum AssignmentStatus {
  UNASSIGNED
  ASSIGNED
}

// A concrete, dated occurrence of a cleaning activity. Never deleted when an
// employee becomes unavailable — only the employee allocation changes and the
// status reverts to UNASSIGNED (see PROJECT_SPEC.md section 17).
model Assignment {
  id                        String           @id @default(cuid())
  companyId                 String
  serviceId                 String
  employeeId                String?
  date                      DateTime         @db.Date
  durationMinutes           Int
  status                    AssignmentStatus @default(UNASSIGNED)
  // The single mechanism for "this employee needs to accept this activity"
  // — covers both a fresh proposal (was UNASSIGNED) and a reassignment
  // (had someone else before). When set on an ASSIGNED activity,
  // confirmedAt stays null until the employee accepts it; rejecting reverts
  // the activity to UNASSIGNED instead (employeeId/requiresConfirmation/
  // confirmedAt all cleared) rather than tracking a separate rejected
  // state — there's nothing left to represent once nobody owns it anymore.
  // A pending-confirmation activity still blocks the employee's slot for
  // conflict checks and still gets freed by an approved absence, exactly
  // like a confirmed one — this flag only tracks "has this employee said
  // yes yet", it doesn't change scheduling.
  requiresConfirmation      Boolean          @default(false)
  confirmedAt               DateTime?
  sourceRecurringScheduleId String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  service        Service            @relation(fields: [serviceId], references: [id])
  employee       Employee?          @relation(fields: [employeeId], references: [id])
  sourceSchedule RecurringSchedule? @relation(fields: [sourceRecurringScheduleId], references: [id])

  // Postgres treats NULLs as distinct, so this only enforces idempotent
  // generation among assignments created from a recurring schedule; manually
  // created assignments (sourceRecurringScheduleId = null) are unaffected.
  @@unique([sourceRecurringScheduleId, date])
  @@index([companyId, date])
  @@index([employeeId, date])
  @@map("assignments")
}

// ---------------------------------------------------------------------------
// Absences
// ---------------------------------------------------------------------------

enum AbsenceType {
  VACATION
  PERMISSION
  SICKNESS
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model AbsenceRequest {
  id         String        @id @default(cuid())
  companyId  String
  employeeId String
  type       AbsenceType
  startDate  DateTime      @db.Date
  endDate    DateTime      @db.Date
  notes      String?
  status     AbsenceStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, status])
  @@index([employeeId, startDate, endDate])
  @@map("absence_requests")
}
